{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "rootDir": ".", "outDir": "dist", "strict": true,
    "noUncheckedIndexedAccess": true, "esModuleInterop": true,
    "skipLibCheck": true, "sourceMap": true, "declaration": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
}
