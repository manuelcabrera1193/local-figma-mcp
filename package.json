{
  "name": "local-figma-mcp",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Local model-independent Figma design context, authentication, assets and visual validation",
  "bin": {
    "local-figma-mcp": "dist/src/index.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "docs",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:coverage": "c8 --include='src/**/*.ts' --exclude='src/index.ts' --reporter=text --reporter=json-summary node --import tsx --test tests/*.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "mcp": "node dist/src/index.js",
    "prepack": "npm run build",
    "install:global": "node scripts/install-global.mjs",
    "research:test": "node --import tsx --test research/*.test.ts",
    "check:publication": "node scripts/check-publication.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "jsonc-parser": "3.3.1",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pngjs": "6.0.5",
    "c8": "12.0.0",
    "playwright": "^1.65.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "license": "MIT",
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manuelcabrera1193/local-figma-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/manuelcabrera1193/local-figma-mcp/issues"
  }
}
